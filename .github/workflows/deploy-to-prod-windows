name: 2. Deploy to Prod - Windows

on:
  workflow_dispatch:
    inputs:
      version:
        description: "Version tag to deploy — leave as 'latest' to auto-detect"
        required: true
        default: "latest"

concurrency:
  group: deploy-to-prod
  cancel-in-progress: false

jobs:
  resolve-version:
    name: Resolve version
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.resolve.outputs.version }}

    steps:
      - name: Resolve version
        id: resolve
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          INPUT: ${{ github.event.inputs.version }}
        run: |
          if [ "$INPUT" = "latest" ]; then
            VERSION=$(gh release list --repo "${{ github.repository }}" --limit 1 --json tagName --jq '.[0].tagName')
            echo "Resolved latest: $VERSION"
          else
            VERSION="$INPUT"
          fi
          if [ -z "$VERSION" ]; then
            echo "::error::Could not resolve a version to deploy (no releases found?)"
            exit 1
          fi
          echo "version=$VERSION" >> "$GITHUB_OUTPUT"

  deploy:
    name: Deploy ${{ needs.resolve-version.outputs.version }} to prod
    needs: resolve-version
    runs-on: [self-hosted, prod]
    environment: prod
    env:
      GIT_CONFIG_COUNT: "1"
      GIT_CONFIG_KEY_0: safe.directory
      GIT_CONFIG_VALUE_0: ${{ vars.REPO_PATH }}

    steps:
      - name: Fetch tags
        run: git -C "${{ vars.REPO_PATH }}" fetch --tags origin

      - name: Update config and projects
        run: |
          cd "${{ vars.REPO_PATH }}"
          git rm -r --quiet --cached --ignore-unmatch .
          git checkout "${{ needs.resolve-version.outputs.version }}" -- .
          git clean -fd .
          git update-ref HEAD "${{ needs.resolve-version.outputs.version }}"

      - name: Scan Config Updates
        run: |
          $HOST_IP = (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -notlike "127.*" -and $_.IPAddress -notlike "169.254.*" } | Select-Object -First 1).IPAddress
          $RESPONSE = Invoke-RestMethod -Method Post -Uri "http://${HOST_IP}:${{ vars.GATEWAY_PORT }}/data/api/v1/scan/config" `
            -Headers @{ "X-Ignition-API-Token" = "${{ secrets.IGNITION_API_TOKEN }}"; "Content-Type" = "application/json" } `
            -Body '{}'
          Write-Host "Config scan response: $($RESPONSE | ConvertTo-Json -Compress)"

      - name: Scan Project Updates
        run: |
          $HOST_IP = (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -notlike "127.*" -and $_.IPAddress -notlike "169.254.*" } | Select-Object -First 1).IPAddress
          $RESPONSE = Invoke-RestMethod -Method Post -Uri "http://${HOST_IP}:${{ vars.GATEWAY_PORT }}/data/api/v1/scan/projects" `
            -Headers @{ "X-Ignition-API-Token" = "${{ secrets.IGNITION_API_TOKEN }}"; "Content-Type" = "application/json" } `
            -Body '{}'
          Write-Host "Projects scan response: $($RESPONSE | ConvertTo-Json -Compress)"
